# Optional server-managed OpenAI-compatible provider. Never commit a real key.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4.1-mini
REASONING_LLM_MODEL=o4-mini
CODE_LLM_MODEL=gpt-4.1
AI_GATEWAY_TIMEOUT_SECONDS=120

# Local development only. Allows HTTP only for literal loopback provider URLs.
AI_GATEWAY_ALLOW_INSECURE_LOOPBACK=false

# Disabled by default. When true, the local UI may send an ephemeral provider
# key in a request. The server never stores or returns it. Do not enable on a
# shared or public deployment.
AI_GATEWAY_ALLOW_RUNTIME_CREDENTIALS=false
